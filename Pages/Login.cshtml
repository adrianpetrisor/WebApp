@page
@model WebApp.Pages.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <title>Autentificare - iTEC</title>
    <link rel="icon" type="image/png" href="/media/web-icon.png" />
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            height: 100vh;
            background: #161616;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ddd;
        }

        .authentication-form {
            width: 400px;
            background: rgba(30, 30, 30, 0.75);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .authentication-form h2 {
            margin-bottom: 10px;
            font-size: 28px;
        }

        .authentication-form .description {
            font-size: 14px;
            color: #aaa;
            text-align: center;
            margin-bottom: 20px;
        }

        .form-group {
            position: relative;
            width: 100%;
            margin-bottom: 15px;
        }

        .form-group svg {
            position: absolute;
            top: 50%;
            left: 12px;
            transform: translateY(-50%);
            fill: #c5c5c5;
        }

        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 12px 12px 12px 38px;
            border: 2px solid #3d3d3d;
            border-radius: 6px;
            background: transparent;
            color: #c5c5c5;
            font-size: 15px;
            outline: none;
        }

        input:focus {
            border-color: #3654ff;
        }

        .authentication-button {
            margin-top: 10px;
            width: 100%;
            background: transparent;
            color: #fff;
            padding: 12px;
            font-size: 16px;
            border: 2px solid #3654ff;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            transition: all 0.4s ease;
        }

        .authentication-button:hover {
            background: #3654ff;
        }

        .google-auth-button {
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #fff;
            color: #333;
            padding: 10px;
            width: 100%;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .google-auth-button:hover {
            transform: scale(1.02);
        }

        .signup-link {
            margin-top: 15px;
            font-size: 14px;
            color: #aaa;
        }

        .signup-link a {
            color: #3654ff;
            text-decoration: none;
        }

        .signup-link a:hover {
            text-decoration: underline;
        }

        .validation-message {
            margin-top: 10px;
            color: #ff6666;
            font-size: 14px;
        }

        svg.icon {
            width: 20px;
            height: 20px;
        }
    </style>
</head>
<body>

    <section class="authentication-form">
        <h2>Autentificare</h2>
        <p class="description">Autentifică-te pentru a accesa platforma iTEC.</p>

        <form method="post">
            <div class="form-group">
                <svg class="icon" viewBox="0 0 32 32"><path d="M30.853 13.87a15 15 0 0 0-29.729 4.082 15.1 15.1 0 0 0 12.876 12.918 15.6 15.6 0 0 0 2.016.13 14.85 14.85 0 0 0 7.715-2.145 1 1 0 1 0-1.031-1.711 13.007 13.007 0 1 1 5.458-6.529 2.149 2.149 0 0 1-4.158-.759V8.25a1 1 0 0 0-2 0v1.726a8 8 0 1 0 .2 10.325 4.135 4.135 0 0 0 7.83.274 15.2 15.2 0 0 0 .823-7.455zM16 22a6 6 0 1 1 6-6 6.006 6.006 0 0 1-6 6z" fill="#c5c5c5"/></svg>
                <input asp-for="Input.Email" placeholder="Email" type="email" />
            </div>

            <div class="form-group">
                <svg class="icon" viewBox="-64 0 512 512"><path d="M336 512H48c-26.453 0-48-21.523-48-48V240c0-26.477 21.547-48 48-48h288c26.453 0 48 21.523 48 48v224c0 26.477-21.547 48-48 48zm-288-288c-8.813 0-16 7.168-16 16v224c0 8.832 7.187 16 16 16h288c8.813 0 16-7.168 16-16V240c0-8.832-7.187-16-16-16zm256 0c-8.832 0-16-7.168-16-16v-80c0-52.93-43.07-96-96-96s-96 43.07-96 96v80c0 8.832-7.168 16-16 16s-16-7.168-16-16v-80c0-70.594 57.406-128 128-128s128 57.406 128 128v80c0 8.832-7.168 16-16 16z" fill="#c5c5c5"/></svg>
                <input asp-for="Input.Password" placeholder="Parolă" type="password" />
            </div>

            <button class="authentication-button" type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15M19.5 12l-6.75 6.75M19.5 12l-6.75-6.75"/></svg>
                Autentifică-te
            </button>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="validation-message">@Model.ErrorMessage</div>
        }

        <button class="google-auth-button">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 262" width="20" height="20"><path fill="#4285F4" d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027"/><path fill="#34A853" d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1"/><path fill="#FBBC05" d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782"/><path fill="#EB4335" d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251"/></svg>
            Continuă cu Google
        </button>

        <div class="signup-link">
            Nu ai cont? <a href="/Register">Înregistrează-te</a>
        </div>
    </section>

</body>
</html>
