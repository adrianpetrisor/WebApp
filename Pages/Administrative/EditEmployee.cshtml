@page
@model WebApp.Pages.Administrative.EditEmployeeModel
@{
    ViewData["Title"] = "Edit Employee";
}

<h1>Edit Employee</h1>

<form method="post">
    <div class="form-group">
        <label for="UserName">User Name</label>
        <input type="text" class="form-control" id="UserName" value="@Model.Employee.UserName" disabled />
    </div>
    <div class="form-group">
        <label for="Email">Email</label>
        <input type="email" class="form-control" id="Email" value="@Model.Employee.Email" disabled />
    </div>
    <div class="form-group">
        <label for="Roles">Roles</label>
        <select class="form-control" asp-for="Employee.Roles" multiple>
            @foreach (var role in Model.AllRoles)
            {
                <option value="@role" 
                        selected="@Model.Employee.Roles.Contains(role)">
                    @role
                </option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
</form>
